{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/audio/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
      },
      {
        "source": "/images/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
      }
    ]
  }
}
